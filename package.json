    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "psn-api": "^2.18.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.11"
